# Pflicht: langer Zufallsstring, z.B. aus `openssl rand -base64 48`.
# Nachträglich ändern meldet alle Geräte ab.
JWT_SECRET=bitte-aendern-langer-zufaelliger-string

# Für die Adresssuche. Nominatim verlangt laut Nutzungsbedingungen eine
# identifizierende Kennung mit Kontaktmöglichkeit. Fehlt der Wert, bleibt nur
# die Adresssuche aus — Karte und Kartenklick funktionieren weiter.
NOMINATIM_USER_AGENT=Wegzeichen/0.1 (kontakt@example.com)

# Admin-Konto, nur beim allerersten Start relevant
ADMIN_EMAIL=admin@wegzeichen.local
ADMIN_PASSWORD=

# ── Alles Folgende ist optional ───────────────────────────────────────────────

# Erlaubte Origin für CORS. Ohne Angabe: http://localhost:$PORT
CORS_ORIGIN=

# Verzeichnis für Datenbank und Anhänge. Im Container setzt Compose /data.
DATA_DIR=

PORT=3000

# Anzahl vorgelagerter Reverse Proxys. In docker-compose.yml steht 1 als
# Voreinstellung, das passt für einen Proxy davor. Nur anfassen, wenn mehrere
# Proxys gestapelt sind (z.B. Cloudflare-Tunnel plus Caddy: 2).
TRUST_PROXY=
